# Trading switches
LIVE_TRADING=true
TRADING_ENABLED=true
POLYMARKET_TRADING_UNTIL=2026-12-31

# Kalshi (RSA/Ed25519 private key file path, never the key itself)
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY_PATH=kalshi.pk

# Polymarket (international CLOB V2)
POLY_PK=
POLY_FUNDER=
POLY_SIG_TYPE=3

# Weather data
OPENMETEO_API_KEY=
NWS_USER_AGENT=weather-bot-2 (your-email@example.com)

# Execution
MIN_RESTING_BID=0.05
MIN_RESTING_BID_POLYMARKET=0.15
BASKET_COMPLETE_TIMEOUT_MIN=60
OPENMETEO_REFRESH_MIN=180
